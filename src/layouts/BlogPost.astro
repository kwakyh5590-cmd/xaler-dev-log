---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { fade } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagLink from '../components/TagLink.astro';
import { withBase } from '../lib/urls';

type PostData = CollectionEntry<'blog'>['data'];
type PostLink = { id: string; title: string };
interface Props extends PostData {
	headings: MarkdownHeading[];
	readingMinutes: number;
	newer?: PostLink;
	older?: PostLink;
}

const { title, description, pubDate, updatedDate, heroImage, category, tags, headings, readingMinutes, newer, older } = Astro.props;
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const pageFade = fade({ duration: '0.24s' });
---

<html lang="ko" class="motion-enabled" transition:name="root" transition:animate="none">
	<head>
		<BaseHead title={`${title} | Xaler Dev Log`} description={description} image={heroImage} />
	</head>
	<body>
		<div class="reading-progress" aria-hidden="true"><span></span></div>
		<Header />
		<main class="post-main" transition:name="page-content" transition:animate={pageFade}>
			<header class="post-hero">
				<a class="back-top" href={withBase('/blog')}>← ALL NOTES</a>
				<div class="post-meta"><span>{category}</span><FormattedDate date={pubDate} /><span>{readingMinutes}분 읽기</span></div>
				<h1>{title}</h1>
				<p class="description">{description}</p>
				<div class="tags" aria-label="글 태그">{tags.map((tag) => <TagLink tag={tag} />)}</div>
				{updatedDate && <p class="updated">마지막 수정 <FormattedDate date={updatedDate} /></p>}
			</header>

			{heroImage && <div class="hero-image"><Image width={1120} height={560} src={heroImage} alt="" /></div>}

			<div class:list={['article-grid', { 'without-toc': tableOfContents.length === 0 }]}>
				<article class="article-body">
					{tableOfContents.length > 0 && (
						<details class="mobile-toc">
							<summary>이 글의 목차 <span>열기</span></summary>
							<nav aria-label="모바일 글 목차">
								{tableOfContents.map((heading) => <a class:list={{ sub: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}
							</nav>
						</details>
					)}
					<div class="prose-content"><slot /></div>
					<nav class="post-navigation" aria-label="이전 및 다음 글">
						{older ? <a href={withBase(`/blog/${older.id}/`)}><small>← 이전 기록</small><strong>{older.title}</strong></a> : <span></span>}
						{newer ? <a class="newer" href={withBase(`/blog/${newer.id}/`)}><small>다음 기록 →</small><strong>{newer.title}</strong></a> : <span></span>}
					</nav>
					<a class="back-bottom" href={withBase('/blog')}>모든 글로 돌아가기 <span>→</span></a>
				</article>

				{tableOfContents.length > 0 && (
					<aside class="desktop-toc">
						<div>
							<p>ON THIS PAGE</p>
							<nav aria-label="글 목차">
								{tableOfContents.map((heading) => <a class:list={{ sub: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}
							</nav>
							<a class="top-link" href="#top">맨 위로 ↑</a>
						</div>
					</aside>
				)}
			</div>
		</main>
		<Footer />

		<script>
			let articleCleanup = () => {};

			function setupArticle() {
				articleCleanup();
				const progress = document.querySelector<HTMLElement>('.reading-progress span');
				const article = document.querySelector<HTMLElement>('.article-body');
				if (!progress || !article) return;

				const controller = new AbortController();
				const updateProgress = () => {
					const start = article.offsetTop - window.innerHeight * .25;
					const distance = Math.max(article.offsetHeight - window.innerHeight * .45, 1);
					const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
					progress.style.transform = `scaleX(${value})`;
				};
				updateProgress();
				window.addEventListener('scroll', updateProgress, { passive: true, signal: controller.signal });
				window.addEventListener('resize', updateProgress, { signal: controller.signal });

				document.querySelectorAll<HTMLElement>('.prose-content pre:not(.code-block pre)').forEach((pre) => {
					const wrapper = document.createElement('div');
					wrapper.className = 'code-block is-visible';
					pre.parentNode?.insertBefore(wrapper, pre);
					wrapper.appendChild(pre);
					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'copy-code';
					button.textContent = 'COPY';
					button.setAttribute('aria-label', '코드 복사');
					button.addEventListener('click', async () => {
						try {
							await navigator.clipboard.writeText(pre.textContent ?? '');
							button.textContent = 'DONE';
							setTimeout(() => { button.textContent = 'COPY'; }, 1600);
						} catch {
							button.textContent = 'ERROR';
						}
					}, { signal: controller.signal });
					wrapper.appendChild(button);
				});

				const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.desktop-toc nav a')];
				const observedHeadings = tocLinks.map((link) => document.querySelector<HTMLElement>(link.hash)).filter(Boolean) as HTMLElement[];
				const tocObserver = new IntersectionObserver((entries) => {
					const current = entries.find((entry) => entry.isIntersecting);
					if (!current) return;
					tocLinks.forEach((link) => link.classList.toggle('active', link.hash === `#${current.target.id}`));
				}, { rootMargin: '-20% 0px -65% 0px' });
				observedHeadings.forEach((heading) => tocObserver.observe(heading));

				articleCleanup = () => {
					controller.abort();
					tocObserver.disconnect();
				};
			}

			document.addEventListener('astro:page-load', setupArticle);
		</script>
	</body>
</html>

<style>
	.reading-progress { position: fixed; top: 0; right: 0; left: 0; z-index: 40; height: 2px; pointer-events: none; }.reading-progress span { display: block; width: 100%; height: 100%; background: var(--gradient); transform: scaleX(0); transform-origin: left; }
	.post-main { width: var(--wide); max-width: calc(100% - 2rem); padding: 0 0 7rem; }
	.post-hero { max-width: 920px; padding: 5rem 0 4rem; }.back-top { display: inline-flex; min-height: 44px; align-items: center; color: var(--faint); font: 700 .62rem/1 var(--font-code); letter-spacing: .11em; text-decoration: none; }.back-top:hover { color: var(--cyan); }.post-meta { display: flex; margin: 2.2rem 0 1.1rem; flex-wrap: wrap; align-items: center; gap: .8rem; color: var(--faint); font: .68rem/1.5 var(--font-code); }.post-meta span:first-child { color: var(--cyan); letter-spacing: .09em; text-transform: uppercase; }.post-meta > * + *::before { margin-right: .8rem; color: var(--faint); content: '·'; }.post-hero h1 { max-width: 1000px; margin-bottom: 1.4rem; font-size: clamp(3rem, 6.5vw, 5.5rem); line-height: 1.02; letter-spacing: -.062em; word-break: keep-all; text-wrap: balance; }.description { max-width: 720px; color: var(--muted); font-size: 1.05rem; }.tags { display: flex; margin-top: 1.5rem; flex-wrap: wrap; gap: .45rem; }.updated { margin: 1rem 0 0; color: var(--faint); font-size: .72rem; }
	.hero-image { margin-bottom: 4.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-md); }.hero-image :global(img) { display: block; width: 100%; border-radius: 0; }
	.article-grid { display: grid; grid-template-columns: minmax(0, var(--content)) 240px; max-width: 1030px; gap: clamp(3rem, 7vw, 6rem); }.article-grid.without-toc { grid-template-columns: minmax(0, var(--content)); }.article-body { min-width: 0; color: var(--text-soft); }
	.prose-content :global(p), .prose-content :global(li) { color: var(--text-soft); }.prose-content :global(p) { margin-bottom: 1.65rem; }.prose-content :global(ul), .prose-content :global(ol) { margin: 1.3rem 0 2rem; padding-left: 1.4rem; }.prose-content :global(li) { margin: .45rem 0; }.prose-content :global(h2) { margin: 4.2rem 0 1.4rem; padding-top: 1rem; font-size: clamp(1.8rem, 3vw, 2.35rem); scroll-margin-top: calc(var(--header-height) + 2rem); }.prose-content :global(h3) { margin: 3rem 0 1rem; padding-top: .8rem; scroll-margin-top: calc(var(--header-height) + 2rem); }.prose-content :global(a) { text-decoration-thickness: 1px; }.prose-content :global(img) { margin: 1rem 0 2rem; border: 1px solid var(--line); }
	.desktop-toc > div { position: sticky; top: calc(var(--header-height) + 2.4rem); padding-left: 1.3rem; border-left: 1px solid var(--line); }.desktop-toc p { margin: 0 0 1rem; color: var(--faint); font: 700 .62rem/1 var(--font-code); letter-spacing: .12em; }.desktop-toc nav { display: grid; gap: .12rem; }.desktop-toc a { display: block; padding: .42rem 0; color: var(--muted); font-size: .73rem; line-height: 1.45; text-decoration: none; }.desktop-toc a.sub { padding-left: .8rem; font-size: .68rem; }.desktop-toc a:hover, .desktop-toc a.active { color: var(--cyan); }.desktop-toc .top-link { margin-top: 1.3rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--faint); font: .62rem/1 var(--font-code); }
	.mobile-toc { display: none; margin-bottom: 2.5rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }.mobile-toc summary { display: flex; min-height: 52px; padding: 0 1rem; align-items: center; justify-content: space-between; color: var(--text); cursor: pointer; font-size: .8rem; font-weight: 700; list-style: none; }.mobile-toc summary::-webkit-details-marker { display: none; }.mobile-toc summary span { color: var(--faint); font: .62rem/1 var(--font-code); }.mobile-toc nav { display: grid; padding: 0 1rem 1rem; }.mobile-toc a { padding: .4rem 0; color: var(--muted); font-size: .75rem; text-decoration: none; }.mobile-toc a.sub { padding-left: .8rem; }
	.post-navigation { display: grid; grid-template-columns: 1fr 1fr; margin-top: 5rem; gap: .8rem; }.post-navigation > a { display: grid; min-height: 120px; padding: 1.2rem; align-content: center; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--text-soft); text-decoration: none; }.post-navigation > a:hover { border-color: var(--line-strong); color: var(--cyan); }.post-navigation .newer { text-align: right; }.post-navigation small { margin-bottom: .5rem; color: var(--faint); font: .62rem/1 var(--font-code); }.post-navigation strong { font-size: .84rem; line-height: 1.5; }.back-bottom { display: inline-flex; min-height: 48px; margin-top: 2.5rem; align-items: center; gap: .7rem; color: var(--muted); font-size: .78rem; text-decoration: none; }.back-bottom:hover { color: var(--cyan); }
	@media (max-width: 900px) { .article-grid { grid-template-columns: minmax(0, var(--content)); max-width: var(--content); }.desktop-toc { display: none; }.mobile-toc { display: block; } }
	@media (max-width: 640px) {
		.post-main { max-width: calc(100% - 1.5rem); padding-bottom: 5rem; }.post-hero { padding: 3rem 0; }.post-meta { margin-top: 1.5rem; }.post-hero h1 { max-width: 100%; font-size: clamp(2.15rem, 9.6vw, 3rem); line-height: 1.12; letter-spacing: -.045em; }.description { font-size: .94rem; }.hero-image { margin-bottom: 2.8rem; }.prose-content :global(h2) { margin-top: 3.5rem; }.post-navigation { grid-template-columns: 1fr; }.post-navigation > span:empty { display: none; }.post-navigation .newer { text-align: left; }
	}
</style>
