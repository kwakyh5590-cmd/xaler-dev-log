---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { fade } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const pageFade = fade({ duration: '0.24s' });
---

<!doctype html>
<html lang="ko" class="motion-enabled" transition:name="root" transition:animate="none">
	<head><BaseHead title={title} description={description} /></head>
	<body>
		<Header />
		<main class:list={{ wide }} transition:name="page-content" transition:animate={pageFade}><slot /></main>
		<Footer />
	</body>
</html>
