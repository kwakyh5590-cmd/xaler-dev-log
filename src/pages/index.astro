---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TagLink from '../components/TagLink.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
import { withBase } from '../lib/urls';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} wide>
	<section class="hero">
		<div class="eyebrow"><span></span> BUILD · LEARN · DOCUMENT</div>
		<h1><span>코드보다 오래 남는</span><em>배움의 기록.</em></h1>
		<p>{SITE_DESCRIPTION}</p>
		<div class="actions"><a class="primary" href={withBase('/blog')}>글 살펴보기 <span>→</span></a><a class="secondary" href={withBase('/about')}>블로그 소개</a></div>
	</section>
	<section class="principles" aria-label="기록 원칙">
		<article><span>01</span><h2>직접 실행</h2><p>실제로 만들고 확인한 내용만 기록합니다.</p></article>
		<article><span>02</span><h2>해결 과정</h2><p>결과뿐 아니라 막힌 이유와 판단을 남깁니다.</p></article>
		<article><span>03</span><h2>쉬운 설명</h2><p>미래의 나도 다시 이해할 수 있게 씁니다.</p></article>
	</section>
	<section class="recent">
		<div class="section-heading"><div><span>RECENT NOTES</span><h2>최근 기록</h2></div><a href={withBase('/blog')}>전체 보기 →</a></div>
		<div class="post-grid">
			{posts.map((post) => <article class="post-card"><a class="post-main" href={withBase(`/blog/${post.id}/`)}><div class="meta"><span>{post.data.category}</span><FormattedDate date={post.data.pubDate} /></div><h3>{post.data.title}</h3><p>{post.data.description}</p></a><div class="tags">{post.data.tags.slice(0,3).map((tag) => <TagLink tag={tag} />)}</div></article>)}
		</div>
	</section>
</PageLayout>

<style>
	.hero{padding:7rem 0 6rem;max-width:900px}.eyebrow{display:flex;align-items:center;gap:.65rem;color:#67e8f9;font:700 .75rem/1 var(--font-atkinson);letter-spacing:.16em}.eyebrow span{width:34px;height:2px;background:#22d3ee}h1{margin:1.6rem 0;padding-bottom:.08em;color:#f8fafc;font-size:clamp(3.4rem,8vw,6.8rem);letter-spacing:-.065em;line-height:1.02}h1>span,h1 em{display:block;white-space:nowrap}h1 em{width:max-content;padding:0 .09em .08em 0;margin-bottom:-.08em;color:transparent;font-style:normal;background:linear-gradient(90deg,#67e8f9,#818cf8);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent}.hero p{max-width:640px;color:#94a3b8;font-size:1.15rem}.actions{display:flex;gap:.8rem;margin-top:2.2rem}.actions a{display:inline-flex;min-height:48px;padding:0 1.15rem;align-items:center;justify-content:center;border-radius:10px;text-decoration:none;font-size:.9rem;font-weight:700;line-height:1;box-sizing:border-box}.primary{background:#f8fafc;color:#0f172a}.primary span{display:inline-flex;margin-left:.65rem;align-items:center}.secondary{color:#cbd5e1;border:1px solid rgba(148,163,184,.25)}.principles{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(148,163,184,.16);border-bottom:1px solid rgba(148,163,184,.16)}.principles article{padding:2.2rem;border-right:1px solid rgba(148,163,184,.16)}.principles article:last-child{border-right:0}.principles span,.section-heading span{color:#22d3ee;font-size:.72rem;letter-spacing:.12em}.principles h2{margin:.8rem 0 .4rem;color:#e2e8f0;font-size:1rem}.principles p{margin:0;color:#64748b;font-size:.86rem}.recent{padding:6rem 0}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:1.8rem}.section-heading>div{padding-left:1ch}.section-heading h2{margin:.35rem 0 0;color:#f8fafc;font-size:2.2rem}.section-heading a{display:inline-flex;min-height:44px;padding:0 .25rem;align-items:center;color:#94a3b8;text-decoration:none;font-size:.85rem;box-sizing:border-box}.post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.post-card{min-height:250px;padding:1.5rem;border:1px solid rgba(148,163,184,.16);border-radius:16px;background:rgba(15,23,42,.5);transition:transform .2s,border-color .2s}.post-card:hover{transform:translateY(-4px);border-color:rgba(34,211,238,.55)}.post-main{display:block;color:inherit;text-decoration:none}.meta{display:flex;justify-content:space-between;color:#64748b;font-size:.72rem}.meta span{color:#67e8f9}.post-card h3{margin:1.4rem 0 .7rem;color:#f1f5f9;font-size:1.25rem}.post-card p{color:#94a3b8;font-size:.88rem}.tags{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1.2rem}@media(max-width:800px){.principles,.post-grid{grid-template-columns:1fr}.principles article{border-right:0;border-bottom:1px solid rgba(148,163,184,.16)}.hero{padding:5rem 0 4rem}}@media(max-width:480px){h1{font-size:clamp(2.1rem,9vw,2.5rem)}}
</style>
