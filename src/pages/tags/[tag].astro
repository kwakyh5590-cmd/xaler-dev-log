---
import { getCollection, type CollectionEntry } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { withBase } from '../../lib/urls';

interface Props {
	tag: string;
	posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<PageLayout title={`#${tag} 글 | Xaler Dev Log`} description={`#${tag} 태그가 포함된 개발 기록입니다.`} wide>
	<header class="page-header">
		<p class="eyebrow">TAGGED NOTES</p>
		<h1>#{tag}</h1>
		<p>{posts.length}개의 기록을 모았습니다.</p>
	</header>
	<div class="post-list">
		{posts.map((post, index) => (
			<a href={withBase(`/blog/${post.id}/`)}>
				<span class="number">{String(index + 1).padStart(2, '0')}</span>
				<div class="content">
					<div class="meta"><span>{post.data.category}</span><FormattedDate date={post.data.pubDate} /></div>
					<h2>{post.data.title}</h2>
					<p>{post.data.description}</p>
				</div>
				<span class="arrow" aria-hidden="true">↗</span>
			</a>
		))}
	</div>
	<a class="back" href={withBase('/blog')}>← 모든 글 보기</a>
</PageLayout>

<style>
	.page-header { padding: 5rem 0 3.5rem; }.page-header h1 { margin: .65rem 0; color: transparent; font-size: clamp(3rem, 8vw, 6rem); letter-spacing: -.06em; background: var(--gradient); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }.page-header > p:last-child { color: var(--muted); }
	.post-list { border-top: 1px solid var(--line); }.post-list > a { display: grid; grid-template-columns: 60px 1fr 40px; min-height: 44px; padding: 2rem 0; align-items: start; gap: 1.5rem; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }.number { color: var(--faint); font: .7rem/1.7 var(--font-code); }.meta { display: flex; gap: .8rem; color: var(--faint); font: .65rem/1.5 var(--font-code); }.meta span { color: var(--cyan); }.content h2 { margin: .65rem 0 .45rem; font-size: clamp(1.45rem, 3vw, 1.9rem); }.content p { margin: 0; color: var(--muted); font-size: .84rem; }.arrow { justify-self: end; color: var(--faint); transition: transform .2s ease, color .2s ease; }.post-list > a:hover h2, .post-list > a:hover .arrow { color: var(--cyan); }.post-list > a:hover .arrow { transform: translate(4px, -4px); }.back { display: inline-flex; min-height: 48px; margin-top: 2rem; align-items: center; color: var(--muted); font-size: .78rem; text-decoration: none; }.back:hover { color: var(--cyan); }
	@media (max-width: 640px) { .page-header { padding: 3.5rem 0 2.5rem; }.post-list > a { grid-template-columns: 1fr 30px; gap: .7rem; }.number { display: none; } }
</style>
