---
import { getCollection, type CollectionEntry } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { withBase } from '../../lib/urls';

interface Props {
	tag: string;
	posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<PageLayout title={`#${tag} 글 | Xaler Dev Log`} description={`#${tag} 태그가 포함된 개발 기록입니다.`} wide>
	<header class="page-header">
		<span>TAGGED NOTES</span>
		<h1>#{tag}</h1>
		<p>{posts.length}개의 기록을 모았습니다.</p>
	</header>
	<div class="post-list">
		{posts.map((post, index) => (
			<a href={withBase(`/blog/${post.id}/`)}>
				<span class="number">{String(index + 1).padStart(2, '0')}</span>
				<div class="content">
					<div class="meta"><span>{post.data.category}</span><FormattedDate date={post.data.pubDate} /></div>
					<h2>{post.data.title}</h2>
					<p>{post.data.description}</p>
				</div>
				<span class="arrow" aria-hidden="true">↗</span>
			</a>
		))}
	</div>
	<a class="back" href={withBase('/blog')}>← 모든 글 보기</a>
</PageLayout>

<style>
	.page-header{padding:5rem 0 3rem}.page-header>span{color:#22d3ee;font-size:.72rem;letter-spacing:.14em}.page-header h1{margin:.75rem 0;font-size:clamp(2.6rem,7vw,5rem);letter-spacing:-.055em}.page-header p{color:#94a3b8}.post-list{border-top:1px solid rgba(148,163,184,.18)}.post-list>a{display:grid;grid-template-columns:60px 1fr 40px;gap:1.5rem;min-height:44px;padding:2rem 0;border-bottom:1px solid rgba(148,163,184,.18);color:inherit;text-decoration:none;box-sizing:border-box}.number{color:#475569;font-size:.78rem}.meta{display:flex;gap:1rem;color:#64748b;font-size:.75rem}.meta span{color:#67e8f9}h2{margin:.55rem 0;font-size:1.55rem}.content p{margin:0;color:#94a3b8;font-size:.9rem}.arrow{color:#64748b;transition:transform .2s}.post-list>a:hover .arrow{color:#67e8f9;transform:translate(4px,-4px)}.back{display:inline-flex;min-height:44px;margin-top:2rem;align-items:center;color:#67e8f9;text-decoration:none}@media(max-width:640px){.page-header{padding:3rem 0 2rem}.post-list>a{grid-template-columns:1fr 30px}.number{display:none}}
</style>
