---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
import { withBase } from '../../lib/urls';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout title="모든 글 | Xaler Dev Log" description={SITE_DESCRIPTION} wide>
	<header class="page-header"><span>ALL NOTES</span><h1>배우고 해결한 기록</h1><p>프로젝트, 디버깅, 학습, 개발 회고를 정리합니다.</p></header>
	<section class="post-list">
		{posts.map((post,index) => <a href={withBase(`/blog/${post.id}/`)}><div class="number">{String(index+1).padStart(2,'0')}</div><div class="content"><div class="meta"><span>{post.data.category}</span><FormattedDate date={post.data.pubDate} /></div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><div class="arrow">↗</div></a>)}
	</section>
</PageLayout>
<style>.page-header{padding:5rem 0 3rem}.page-header span{color:#22d3ee;font-size:.72rem;letter-spacing:.14em}.page-header h1{margin:.75rem 0;font-size:clamp(2.6rem,7vw,5rem);letter-spacing:-.055em}.page-header p{color:#94a3b8}.post-list{border-top:1px solid rgba(148,163,184,.18)}.post-list>a{display:grid;grid-template-columns:60px 1fr 40px;gap:1.5rem;padding:2rem 0;border-bottom:1px solid rgba(148,163,184,.18);color:inherit;text-decoration:none}.number{color:#475569;font-size:.78rem}.meta{display:flex;gap:1rem;color:#64748b;font-size:.75rem}.meta span{color:#67e8f9}h2{margin:.55rem 0;font-size:1.55rem}.content p{margin:0;color:#94a3b8;font-size:.9rem}.arrow{color:#64748b;transition:transform .2s}.post-list>a:hover .arrow{color:#67e8f9;transform:translate(4px,-4px)}@media(max-width:640px){.post-list>a{grid-template-columns:1fr 30px}.number{display:none}}</style>
