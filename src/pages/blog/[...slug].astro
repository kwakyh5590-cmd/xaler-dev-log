---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: index > 0 ? { id: posts[index - 1].id, title: posts[index - 1].data.title } : undefined,
			older: index < posts.length - 1 ? { id: posts[index + 1].id, title: posts[index + 1].data.title } : undefined,
		},
	}));
}
interface Props {
	post: CollectionEntry<'blog'>;
	newer?: { id: string; title: string };
	older?: { id: string; title: string };
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const readableLength = post.body
	.replace(/^---[\s\S]*?---/, '')
	.replace(/[`*_#>\[\]()\-]/g, '')
	.replace(/\s/g, '')
	.length;
const readingMinutes = Math.max(1, Math.ceil(readableLength / 500));
---

<BlogPost {...post.data} headings={headings} readingMinutes={readingMinutes} newer={newer} older={older}>
	<Content />
</BlogPost>
