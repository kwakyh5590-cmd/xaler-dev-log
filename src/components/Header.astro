---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import { withBase } from '../lib/urls';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="주요 메뉴">
		<a class="brand" href={withBase('/')} aria-label={`${SITE_TITLE} 홈`}>
			<span class="brand-mark" aria-hidden="true">
				<img src={withBase('/images/brand/yellow-brick-cat-v1.webp')} alt="" width="256" height="256" />
			</span>
			<span class="brand-copy"><strong>{SITE_TITLE}</strong><small>BUILDING IN PUBLIC</small></span>
		</a>
		<div class="internal-links">
			<HeaderLink href={withBase('/')}>홈</HeaderLink>
			<HeaderLink href={withBase('/blog')}>글</HeaderLink>
			<HeaderLink href={withBase('/about')}>소개</HeaderLink>
		</div>
		<div class="external-links">
			<a class="search-link" href={`${withBase('/blog')}#search`}><span aria-hidden="true">⌕</span> 검색</a>
			<a class="github-link" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub ↗</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 0 1.25rem;
		border-bottom: 1px solid var(--line);
		background: rgba(7, 11, 20, .78);
		backdrop-filter: blur(20px) saturate(145%);
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		max-width: var(--wide);
		min-height: var(--header-height);
		margin: 0 auto;
		align-items: center;
	}
	nav a { color: var(--text-soft); text-decoration: none; }
	.brand {
		display: inline-flex;
		justify-self: start;
		min-height: 48px;
		align-items: center;
		gap: .7rem;
		color: var(--text);
	}
	.brand-mark {
		display: block;
		width: 36px;
		height: 36px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, .12);
		border-radius: 11px;
		background: var(--gradient);
		box-shadow: 0 8px 24px rgba(34, 211, 238, .16);
	}
	.brand-mark img { display: block; width: 100%; height: 100%; object-fit: contain; }
	.brand-copy { display: grid; gap: .14rem; }
	.brand-copy strong { font-size: .92rem; line-height: 1; letter-spacing: -.01em; }
	.brand-copy small { color: var(--faint); font: 700 .52rem/1 var(--font-code); letter-spacing: .12em; }
	.internal-links {
		display: flex;
		justify-self: center;
		padding: .22rem;
		align-items: center;
		gap: .1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgba(15, 23, 42, .55);
	}
	:global(.internal-links a) {
		display: inline-flex;
		min-width: 52px;
		min-height: 38px;
		padding: 0 .8rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		color: var(--muted);
		font-size: .78rem;
		line-height: 1;
	}
	:global(.internal-links a:hover) { color: var(--text); }
	:global(.internal-links a.active) { background: rgba(103, 232, 249, .1); color: var(--cyan); }
	.external-links { display: flex; justify-self: end; align-items: center; gap: .35rem; }
	.external-links a {
		display: inline-flex;
		min-height: 44px;
		padding: 0 .85rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		font-size: .76rem;
		line-height: 1;
	}
	.search-link { color: var(--muted); }
	.github-link { border: 1px solid var(--line); }
	.external-links a:hover { border-color: var(--line-strong); color: var(--cyan); }
	@media (max-width: 760px) {
		header { padding: 0 .75rem; }
		nav {
			grid-template-areas:
				'brand external'
				'menu menu';
			grid-template-columns: minmax(0, 1fr) 44px;
			min-height: auto;
			padding: .7rem 0;
			row-gap: .6rem;
		}
		.brand { grid-area: brand; }
		.brand-copy { display: grid !important; }
		.brand-copy small, .search-link { display: none !important; }
		.internal-links { grid-area: menu; justify-self: center; }
		.external-links { grid-area: external; }
		:global(.internal-links a) { min-width: 46px; min-height: 36px; padding: 0 .55rem; }
		.github-link { width: 44px; padding: 0 !important; overflow: hidden; color: transparent !important; }
		.github-link::before { color: var(--muted); content: '↗'; font-size: 1rem; }
	}
</style>
